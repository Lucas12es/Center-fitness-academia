# URL pública do site (usada em canonical, sitemap, Open Graph e Schema.org)
NEXT_PUBLIC_SITE_URL=https://centerfitness.example.com

# Google Analytics 4 (opcional). Quando preenchido, o banner de cookies é exibido
# e o GA só carrega após o consentimento do visitante.
NEXT_PUBLIC_GA_ID=

# Código de verificação do Google Search Console (opcional)
NEXT_PUBLIC_GSC_VERIFICATION=


# CNPJ / razão social para as páginas legais (opcional — exibidos se preenchidos)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_CNPJ=
